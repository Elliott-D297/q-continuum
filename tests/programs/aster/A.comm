exec(open('/home/user/heatBench/aster/common_head.py').read())
bc = AFFE_CHAR_CINE(MODELE=model, THER_IMPO=_F(GROUP_NO=('LEFT', 'RIGHT'), TEMP=300.0))
T0 = CREA_CHAMP(TYPE_CHAM='NOEU_TEMP_R', OPERATION='AFFE', MAILLAGE=mesh, AFFE=_F(TOUT='OUI', NOM_CMP='TEMP', VALE=300.))
_xyz = mesh.getCoordinates().getValues()
