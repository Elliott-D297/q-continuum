open $SB/ws/cavity
click nav:studies
wait-until page Studies
wait 10
click st-new
wait-until modal any timeout 5
click st-mode#1
wait 3
click st-name
key A ctrl
type vec
choose st-file#0 0/U
wait 3
click st-key#0
key A ctrl
type boundaryField/movingWall/value
wait 3
click st-vals#0
key A ctrl
type uniform (1 0 0), uniform (2 0 0)
wait 5
dump $OUT/c.txt
screenshot $OUT/c.png
click st-go
wait 60
dump $OUT/d.txt
shell ls $SB/ws > $OUT/ws2.txt
shell grep -H -A3 "movingWall" $SB/ws/*/0/U > $OUT/us.txt
