# Bug hunt H-19: RED ALERT's Halve with "deltaT $dtBase;" shows and halves the number the macro stands for.
open $SB/ws/cavVar
shell printf '%s\n' '#!/bin/bash' 'exec > log.icoFoam 2>&1' 'echo "Starting time loop"' 'co=0.5' 'for i in $(seq 1 80); do' '  echo; echo "Time = $(echo "$i*0.005" | bc -l)"; echo' '  echo "Courant Number mean: 0.1 max: $co"' '  echo "smoothSolver:  Solving for Ux, Initial residual = 0.001, Final residual = 1e-08, No Iterations 4"' '  echo "ExecutionTime = 0.$i s  ClockTime = 0 s"' '  co=$(echo "$co*1.15" | bc -l); sleep 0.05' 'done' 'sleep 300' > Allrun
shell chmod +x Allrun
key F5
wait 30
click nav:run
wait-until page Run
click run-mode#1
wait 5
click run-go
wait 10
click? m-pc-go
wait-until job running timeout 30
wait-until text Red alert timeout 30
wait 5
assert text (0.005 -> 0.0025)
assert enabled ra-halve
click ra-halve
wait 5
assert toast deltaT $dtBase = 0.005 -> 0.0025, saved
assert log system/controlDict deltaT          0.0025;
assert log system/controlDict dtBase          0.005;
click top-stop
wait-until job idle timeout 30
