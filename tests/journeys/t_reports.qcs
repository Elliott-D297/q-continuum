# Reports (setup plan step 6, 2026-11-01): a duct (the converging nozzle's mesh) set up as internal flow, and one report of
# each kind added from the Reports step's menu: probe points, a surface average, a flow rate, a pressure drop, the
# domain's greatest speed. After the run the Run page lists each with its latest value, a click plots it, and Export CSV
# writes them to reports/. Answers "what is my pressure drop?" and "what is the speed here?" without ParaView.
budget p95 80 max 600
shell mkdir -p $SB/ws/duct/system && python3 $QC_TESTS/tools/nozzle_mesh.py conv > $SB/ws/duct/system/blockMeshDict && printf 'FoamFile { version 2.0; format ascii; class dictionary; object controlDict; }\napplication simpleFoam;\nstartTime 0;\nendTime 10;\ndeltaT 1;\nwriteControl timeStep;\nwriteInterval 10;\n' > $SB/ws/duct/system/controlDict && cd $SB/ws/duct && bash -c '. "$WM_PROJECT_DIR/etc/bashrc" > /dev/null 2>&1; blockMesh > log.blockMesh 2>&1'
open $SB/ws/duct
click nav:physics
wait-until page Physics
wait 10
click su-tmpl#1
wait 10
assert log simulation.ini template = internalFlow
click su-step#4
wait 5
assert text Measured while it runs
assert text None yet
screenshot $OUT/01_reports_empty.png
click su-rep-add
wait 3
click text:Probe points: values at points
wait 5
assert log simulation.ini kind = probes
click su-rep-add
wait 3
click text:Pressure drop between two boundaries
wait 5
assert log simulation.ini kind = pressureDrop
assert text Pressure drop from inlet to outlet
click su-rep-add
wait 3
click text:Volume: the average, least or greatest in the domain
wait 5
click su-rep-add
wait 3
click text:Surface: an average, a flow rate, the least or greatest on a boundary
wait 5
note the surface report: the flow rate through the outlet
click su-rep#3>op
wait 3
click text:Flow rate
wait 5
assert log simulation.ini operation = flowRate
assert text Flow rate through outlet
screenshot $OUT/02_reports.png
click su-step#5
wait 5
click su-it
key A ctrl
enter 200
wait 3
click su-step#6
wait 5
assert text Nothing to fix
click su-check-run
wait-until page Run
wait 10
click run-go
wait-until job running timeout 30
wait-until job finished timeout 300
assert log log.simpleFoam End
assert not log log.simpleFoam FOAM FATAL
wait 20
assert file postProcessing/probes1/0/mag(U)
assert file postProcessing/pressureDrop1/0/multiFieldValue.dat
assert file postProcessing/volume1/0/volFieldValue.dat
assert file postProcessing/surface1/0/surfaceFieldValue.dat
assert file postProcessing/yPlus/0/yPlus.dat
note the Run page's reports: each with its value, once the monitors have read their files
wait-until widget chart-tab#1 timeout 60
wait 10
wheel 0 rep-row#0
assert widget rep-row#0
assert widget rep-row#3
assert text Pressure drop from inlet to outlet
assert text Speed at 1 point
assert not text not yet
screenshot $OUT/03_run_reports.png
click rep-row#1
wait 10
screenshot $OUT/04_drop_chart.png
click rep-csv
wait 5
assert file reports/pressureDrop1.csv
assert file reports/probes1.csv
assert log reports/surface1.csv time,
