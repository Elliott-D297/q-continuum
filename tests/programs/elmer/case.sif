Header
  Mesh DB "." "mesh"
End
Simulation
  Coordinate System = Cartesian 3D
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 1
  Timestep Sizes = 0.5
  Timestep Intervals = 200
  Steady State Max Iterations = 1
  Output Intervals = 200
  Max Output Level = 5
End
Body 1
  Equation = 1
  Initial Condition = 1
  Material = 1
End
Material 1
  Heat Conductivity = 16.2
  Density = 8000.0
  Heat Capacity = 500.0
End
Initial Condition 1
  Temperature = Variable Coordinate
    Real MATC "300 + 100*sin(pi*tx(0)/0.1)*sin(pi*tx(1)/0.1)*sin(pi*tx(2)/0.1)"
End
Equation 1
  Active Solvers(2) = 1 2
End
Solver 1
  Equation = Heat Equation
  Procedure = "HeatSolve" "HeatSolver"
  Variable = Temperature
  Linear System Solver = Iterative
  Linear System Iterative Method = CG
  Linear System Preconditioning = ILU0
  Linear System Max Iterations = 20000
  Linear System Convergence Tolerance = 1.0e-12
  Nonlinear System Max Iterations = 1
End
Solver 2
  Exec Solver = After Simulation
  Equation = Result Output
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = res
  Vtu Format = True
  Ascii Output = True
  Single Precision = False
End
Boundary Condition 1
  Target Boundaries(6) = 1 2 3 4 5 6
  Temperature = 300.0
End
