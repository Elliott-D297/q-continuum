times = DEFI_LIST_REEL(DEBUT=0., INTERVALLE=_F(JUSQU_A=250., PAS=1.))
res = THER_LINEAIRE(MODELE=model, CHAM_MATER=chmat, EXCIT=_F(CHARGE=bc), ETAT_INIT=_F(CHAM_NO=T0),
                    INCREMENT=_F(LIST_INST=times), PARM_THETA=1.0)
dump(res, 250., '/home/user/heatBench/aster/../results/code_aster_A.csv')
